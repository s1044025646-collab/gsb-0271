{
  "name": "ks-exact-backend",
  "version": "1.0.0",
  "description": "两样本 KS 距离与精确置换检验后端（TypeScript + Node.js + SQLite）",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && node dist/src/server.js",
    "cli": "npm run build && node dist/src/cli.js",
    "demo": "npm run build && node dist/scripts/demo.js"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
